<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         CUSTOMER INVOICES — Custom Views for the Accounting Team
         ================================================================ -->

    <!-- ===== BASE VIEWS INHERITANCE: Disable Create Globally ===== -->
    <record id="view_invoice_tree_inherit_senjani" model="ir.ui.view">
        <field name="name">account.invoice.list.inherit.senjani</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="create">0</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_out_invoice_tree_inherit_senjani" model="ir.ui.view">
        <field name="name">account.out.invoice.tree.inherit.senjani</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="create">0</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_in_invoice_bill_tree_inherit_senjani" model="ir.ui.view">
        <field name="name">account.in.invoice.bill.tree.inherit.senjani</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="create">0</attribute>
            </xpath>
        </field>
    </record>

    <!-- ===== FORM VIEW: Invoice with Xendit Info ===== -->
    <record id="view_senjani_invoice_form" model="ir.ui.view">
        <field name="name">senjani.account.move.invoice.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Disable direct creation from form view -->
            <xpath expr="//form" position="attributes">
                <attribute name="create">0</attribute>
            </xpath>
            
            <!-- Restrict Confirm and Register Payment buttons to Accounting users only -->
            <xpath expr="//button[@name='action_post'][1]" position="attributes">
                <attribute name="groups">account.group_account_user</attribute>
            </xpath>
            <xpath expr="//button[@name='action_post'][2]" position="attributes">
                <attribute name="groups">account.group_account_user</attribute>
                <attribute name="invisible">hide_post_button or move_type == 'entry' or display_inactive_currency_warning or move_type == 'out_invoice'</attribute>
            </xpath>
            <xpath expr="//button[@name='action_register_payment'][1]" position="attributes">
                <attribute name="groups">account.group_account_user</attribute>
            </xpath>
            <xpath expr="//button[@name='action_register_payment'][2]" position="attributes">
                <attribute name="groups">account.group_account_user</attribute>
            </xpath>

            <!-- Add Xendit info section -->
            <xpath expr="//sheet//group[1]" position="before">
                <group string="🔔 Xendit Payment Information"
                       invisible="not x_show_xendit_info"
                       col="2"
                       class="o_group_senjani_xendit">
                    <field name="payment_reference"
                           string="Payment Reference"
                           readonly="1"/>
                    <field name="x_xendit_payment_status"
                           string="Xendit Status"
                           readonly="1"/>
                    <field name="x_xendit_payment_method"
                           string="Payment Method"
                           readonly="1"/>
                    <field name="x_show_xendit_info" invisible="1"/>
                </group>
            </xpath>
            <!-- Hide default post button on Customer Invoices (moved up) -->
            <!-- Add specialized Validate to In Payment button -->
            <xpath expr="//button[@name='action_post'][2]" position="after">
                <button name="action_post" string="Validate to In Payment" class="oe_highlight"
                        type="object" groups="account.group_account_user" data-hotkey="q"
                        context="{'validate_analytic': True, 'disable_abnormal_invoice_detection': False}"
                        invisible="hide_post_button or move_type != 'out_invoice' or display_inactive_currency_warning"/>
            </xpath>
        </field>
    </record>

    <!-- ===== LIST VIEW: Customer Invoices ===== -->
    <record id="view_senjani_invoice_list" model="ir.ui.view">
        <field name="name">senjani.account.move.invoice.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Customer Invoices"
                  create="0"
                  decoration-info="state == 'draft'"
                  decoration-success="payment_state == 'paid'"
                  decoration-warning="payment_state in ('partial','not_paid') and state == 'posted'"
                  decoration-muted="state == 'cancel'"
                  multi_edit="1">
                <field name="name" string="Invoice Number" optional="show"/>
                <field name="invoice_date" string="Invoice Date" optional="show"/>
                <field name="invoice_date_due" string="Due Date" optional="show"/>
                <field name="partner_id" string="Customer" optional="show"/>
                <field name="payment_reference" string="Payment Reference" optional="show"/>
                <field name="x_xendit_payment_method" string="Payment Method" optional="hide"/>
                <field name="amount_untaxed" string="Untaxed Amount" optional="show"/>
                <field name="amount_tax" string="Tax" optional="hide"/>
                <field name="amount_total" string="Total" optional="show"/>
                <field name="amount_residual" string="Amount Due" optional="show"/>
                <field name="currency_id" string="Currency" optional="hide"/>
                <field name="state" string="Status"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'posted'"
                       decoration-danger="state == 'cancel'"/>
                <field name="payment_state" string="Payment Status"
                       widget="badge"
                       decoration-success="payment_state == 'paid'"
                       decoration-warning="payment_state == 'partial'"
                       decoration-danger="payment_state == 'not_paid'"
                       optional="show"/>
                <field name="move_type" column_invisible="1"/>
                <field name="x_show_xendit_info" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ===== SEARCH VIEW: Customer Invoices ===== -->
    <record id="view_senjani_invoice_search" model="ir.ui.view">
        <field name="name">senjani.account.move.invoice.search</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search string="Search Customer Invoices">
                <field name="name" string="Invoice Number"/>
                <field name="partner_id" string="Customer"/>
                <field name="payment_reference" string="Payment Reference"/>
                <field name="invoice_date" string="Date"/>

                <!-- Filters -->
                <filter name="filter_draft"
                        string="🕐 Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_posted"
                        string="✅ Posted (Unpaid)"
                        domain="[('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]"/>
                <filter name="filter_paid"
                        string="💰 Paid"
                        domain="[('payment_state', '=', 'paid')]"/>
                <filter name="filter_has_xendit"
                        string="💳 Has Xendit Reference"
                        domain="[('x_xendit_payment_ref', '!=', False)]"/>

                <separator/>

                <filter name="filter_this_month"
                        string="📅 This Month"
                        domain="[]"
                        context="{'group_by': 'invoice_date:month'}"/>
                <filter name="filter_this_year"
                        string="📅 This Year"
                        domain="[]"
                        context="{'group_by': 'invoice_date:year'}"/>
                <filter name="filter_overdue"
                        string="⚠️ Overdue"
                        domain="[('invoice_date_due', '!=', False), ('payment_state', 'not in', ['paid', 'in_payment']), ('state', '=', 'posted')]"/>

                <separator/>

                <!-- Group by -->
                <group string="Group By">
                    <filter name="groupby_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="groupby_payment_state" string="Payment Status"
                            context="{'group_by': 'payment_state'}"/>
                    <filter name="groupby_partner" string="Customer"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="groupby_date" string="Date"
                            context="{'group_by': 'invoice_date:month'}"/>
                    <filter name="groupby_xendit_method" string="Xendit Payment Method"
                            context="{'group_by': 'x_xendit_payment_method'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===== ACTION: Customer Invoices ===== -->
    <record id="action_senjani_customer_invoices" model="ir.actions.act_window">
        <field name="name">Customer Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_senjani_invoice_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_senjani_invoice_form')}),
        ]"/>
        <field name="domain">[('move_type', '=', 'out_invoice')]</field>
        <field name="context">{
            'default_move_type': 'out_invoice',
            'search_default_filter_draft': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Customer Invoices yet
            </p>
            <p>
                Invoices are automatically created as Draft from Sales Orders
                paid via Xendit. The sales team prepares draft invoices, which are validated here.
            </p>
        </field>
    </record>

    <!-- ===== ACTION: Credit Notes ===== -->
    <record id="action_senjani_customer_refunds" model="ir.actions.act_window">
        <field name="name">Credit Notes</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_senjani_invoice_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_senjani_invoice_form')}),
        ]"/>
        <field name="domain">[('move_type', '=', 'out_refund')]</field>
        <field name="context">{
            'default_move_type': 'out_refund',
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Credit Notes yet
            </p>
            <p>
                Credit Notes are used to cancel or refund invoices for customers.
            </p>
        </field>
    </record>

    <!-- ===== ACTION: Batch Confirm Invoice ===== -->
    <record id="action_senjani_batch_confirm_invoice" model="ir.actions.server">
        <field name="name">Confirm Selected Invoices</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    records.action_senjani_confirm_invoice()
        </field>
        <field name="groups_id" eval="[(4, ref('senjani_accounting.group_senjani_accounting_staff'))]"/>
    </record>

</odoo>
