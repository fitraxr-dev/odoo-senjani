<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         MAIN MENU — Senjani Accounting
         ================================================================
         Clean and focused menu structure for the Senjani accounting team.

         📊 Accounting (root)
         ├── 🏠 Dashboard
         ├── 📋 Invoices & Bills
         │   ├── Customer Invoices
         │   ├── Credit Notes
         │   ├── Customer Payments
         │   ├── Vendor Bills
         │   ├── Refunds
         │   ├── Vendor Payments
         │   └── Bank Statements
         ├── 📚 Journals
         │   ├── Sales Journal
         │   ├── Purchase Journal
         │   ├── Bank & Cash Journal
         │   └── Miscellaneous Journal
         └── 📈 Reporting
             ├── Financial Reports
             │   ├── Trial Balance
             │   ├── Balance Sheet
             │   ├── Profit and Loss
             │   └── Tax Report
             ├── Ledgers
             │   ├── General Ledger
             │   ├── Partner Ledger
             │   └── Aged Partner Balance
             └── Daily Reports
                 ├── Day Book
                 ├── Cash Book
                 └── Bank Book
         ================================================================ -->

    <!-- ===== ROOT MENU ===== -->
    <menuitem
        id="menu_senjani_accounting_root"
        name="Accounting"
        sequence="30"
        web_icon="senjani_accounting,static/description/icon.png"
        groups="senjani_accounting.group_senjani_accounting_staff"/>

    <!-- ===== DASHBOARD ===== -->
    <menuitem
        id="menu_senjani_accounting_dashboard"
        name="Dashboard"
        parent="menu_senjani_accounting_root"
        action="account.open_account_journal_dashboard_kanban"
        sequence="1"
        groups="senjani_accounting.group_senjani_accounting_staff"/>

    <!-- ===== INVOICES & BILLS ===== -->
    <menuitem
        id="menu_senjani_invoicing"
        name="Invoices &amp; Bills"
        parent="menu_senjani_accounting_root"
        sequence="10"
        groups="senjani_accounting.group_senjani_accounting_staff"/>

    <menuitem
        id="menu_senjani_customer_invoices"
        name="Customer Invoices"
        parent="menu_senjani_invoicing"
        action="senjani_accounting.action_senjani_customer_invoices"
        sequence="1"
        groups="senjani_accounting.group_senjani_accounting_staff"/>

    <menuitem
        id="menu_senjani_customer_refunds"
        name="Credit Notes"
        parent="menu_senjani_invoicing"
        action="senjani_accounting.action_senjani_customer_refunds"
        sequence="2"
