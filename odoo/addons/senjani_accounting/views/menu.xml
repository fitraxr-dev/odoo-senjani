    <!-- Sub: Ledgers -->
    <menuitem
        id="menu_senjani_ledger"
        name="Ledgers"
        parent="menu_senjani_reports"
        sequence="2"
        groups="senjani_accounting.group_senjani_accounting_staff"/>

    <menuitem
        id="menu_senjani_general_ledger"
