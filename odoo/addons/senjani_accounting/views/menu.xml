    <!-- ===== CONFIGURATION (Only Accounting Manager) ===== -->
    <menuitem
        id="menu_senjani_config"
        name="Configuration"
        parent="menu_senjani_accounting_root"
        sequence="100"
        groups="senjani_accounting.group_senjani_accounting_manager"/>

    <menuitem
        id="menu_senjani_config_journals"
        name="Journals"
        parent="menu_senjani_config"
