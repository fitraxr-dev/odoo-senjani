        action="account.action_account_moves_journal_misc"
        sequence="4"
        groups="account.group_account_readonly"/>

    <!-- ===== REPORTING ===== -->
    <menuitem
        id="menu_senjani_reports"
        name="Reporting"
        parent="menu_senjani_accounting_root"
        sequence="40"
        groups="senjani_accounting.group_senjani_accounting_staff"/>

    <!-- Sub: Financial Reports -->
    <menuitem
        id="menu_senjani_financial_reports"
        name="Financial Reports"
        parent="menu_senjani_reports"
