    <menuitem
        id="menu_senjani_customer_payments"
        name="Customer Payments"
        parent="menu_senjani_invoicing"
        action="account.action_account_payments"
        sequence="3"
        groups="senjani_accounting.group_senjani_accounting_staff"/>

    <menuitem
        id="menu_senjani_vendor_bills"
        name="Vendor Bills"
        parent="menu_senjani_invoicing"
        action="senjani_accounting.action_senjani_vendor_bills"
        sequence="4"
        groups="senjani_accounting.group_senjani_accounting_staff"/>

    <menuitem
        id="menu_senjani_vendor_refunds"
        name="Refunds"
        parent="menu_senjani_invoicing"
        action="senjani_accounting.action_senjani_vendor_refunds"
        sequence="5"
        groups="senjani_accounting.group_senjani_accounting_staff"/>

    <menuitem
        id="menu_senjani_vendor_payments"
        name="Vendor Payments"
        parent="menu_senjani_invoicing"
        action="account.action_account_payments_payable"
        sequence="6"
        groups="senjani_accounting.group_senjani_accounting_staff"/>

    <menuitem
        id="menu_senjani_bank_statement"
