<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         MENU UTAMA — Senjani Accounting
         ================================================================
         Struktur menu yang bersih dan fokus untuk tim accounting.

         📊 Akuntansi Senjani (root)
         ├── 🏠 Dashboard
         ├── 📋 Invoice & Tagihan
         │   ├── Invoice Customer
         │   ├── Tagihan Pembelian (Bill)
         │   └── Mutasi Bank BRI
         ├── 🔄 Rekonsiliasi Bank
         ├── 📚 Jurnal
         │   ├── Jurnal Penjualan
         │   ├── Jurnal Pembelian
         │   ├── Jurnal Bank & Kas
         │   └── Jurnal Lainnya
         └── 📈 Laporan
             ├── Laporan Keuangan
             │   ├── Trial Balance
             │   ├── Balance Sheet
             │   ├── Profit & Loss
             │   └── Tax Report
             ├── Buku Besar (Ledger)
             │   ├── General Ledger
             │   ├── Partner Ledger
             │   └── Aged Partner
             └── Laporan Harian
                 ├── Day Book
                 ├── Cash Book
                 └── Bank Book
         ================================================================ -->

    <!-- ===== ROOT MENU ===== -->
    <menuitem
        id="menu_senjani_accounting_root"
        name="Akuntansi"
        sequence="30"
        web_icon="senjani_accounting,static/description/icon.png"
        groups="senjani_accounting.group_senjani_accounting_staff"/>

