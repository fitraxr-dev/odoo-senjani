<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         VENDOR BILL (PURCHASE) — Custom Views untuk Tim Accounting Senjani
         ================================================================
         Alur: Tim Purchasing buat Purchase Order → Terima barang
               → Bill otomatis terbuat Draft
               → Accounting lihat Draft Bill → Confirm → Bayar → Reconcile BRI
               → Accounting lihat Draft Bill → Confirm → Bayar → Reconcile Bank
         ================================================================ -->

    <!-- ===== LIST VIEW: Bill Purchase ===== -->
    <record id="view_senjani_bill_list" model="ir.ui.view">
        <field name="name">senjani.account.move.bill.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Faktur Pembelian (Vendor Bill)"
                  create="0"
                  decoration-info="state == 'draft'"
                  decoration-success="payment_state == 'paid'"
                  decoration-warning="payment_state in ('partial','not_paid') and state == 'posted'"
                  decoration-muted="state == 'cancel'"
                  multi_edit="1">
                <field name="name" string="No. Tagihan" optional="show"/>
                <field name="invoice_date" string="Tgl Tagihan" optional="show"/>
                <field name="invoice_date_due" string="Jatuh Tempo" optional="show"/>
                <field name="partner_id" string="Pemasok" optional="show"/>
                <field name="purchase_id" string="Order Pembelian" optional="show"/>
                <field name="ref" string="Ref. Pemasok" optional="show"/>
                <field name="amount_untaxed" string="Subtotal" optional="show"/>
                <field name="amount_tax" string="Pajak" optional="hide"/>
                <field name="amount_total" string="Total" optional="show"/>
                <field name="amount_residual" string="Sisa Pembayaran" optional="show"/>
                <field name="currency_id" string="Mata Uang" optional="hide"/>
                <field name="state" string="Status"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'posted'"
                       decoration-danger="state == 'cancel'"/>
                <field name="payment_state" string="Status Bayar"
                       widget="badge"
                       decoration-success="payment_state == 'paid'"
                       decoration-warning="payment_state == 'partial'"
                       decoration-danger="payment_state == 'not_paid'"
                       optional="show"/>
                <!-- Hidden fields untuk filter/decor -->
                <field name="move_type" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ===== SEARCH VIEW: Bill Purchase ===== -->
    <record id="view_senjani_bill_search" model="ir.ui.view">
        <field name="name">senjani.account.move.bill.search</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search string="Cari Tagihan Pembelian">
                <field name="name" string="No. Tagihan"/>
                <field name="partner_id" string="Pemasok"/>
                <field name="ref" string="Referensi Pemasok"/>
                <field name="invoice_date" string="Tanggal"/>

                <!-- Filter cepat -->
                <filter name="filter_draft"
                        string="🕐 Draft (Belum Dikonfirmasi)"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_posted"
                        string="✅ Terkonfirmasi (Belum Lunas)"
                        domain="[('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]"/>
                <filter name="filter_paid"
                        string="💰 Lunas"
                        domain="[('payment_state', '=', 'paid')]"/>
                <filter name="filter_overdue"
                        string="⚠️ Jatuh Tempo"
                        domain="[('invoice_date_due', '!=', False), ('payment_state', 'not in', ['paid', 'in_payment']), ('state', '=', 'posted')]"/>

                <separator/>

                <filter name="filter_this_month"
                        string="📅 Bulan Ini"
                        domain="[]"
                        context="{'group_by': 'invoice_date:month'}"/>

                <separator/>

                <!-- Group by -->
                <group string="Kelompokkan">
                    <filter name="groupby_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="groupby_payment_state" string="Status Bayar"
                            context="{'group_by': 'payment_state'}"/>
                    <filter name="groupby_partner" string="Pemasok"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="groupby_date" string="Tanggal"
                            context="{'group_by': 'invoice_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===== ACTION: Daftar Bill Purchase ===== -->
    <record id="action_senjani_vendor_bills" model="ir.actions.act_window">
        <field name="name">Faktur Pembelian (Bill)</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_senjani_bill_list')}),
        ]"/>
        <field name="domain">[('move_type', '=', 'in_invoice')]</field>
        <field name="context">{
            'default_move_type': 'in_invoice',
            'search_default_filter_draft': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada Faktur Pembelian (Bill)
            </p>
            <p>
                Bill (tagihan pembelian) terbuat setelah tim Purchasing membuat
                Purchase Order dan barang diterima. Konfirmasi bill di sini,
                lalu cocokkan dengan mutasi Bank untuk menyelesaikan pembayaran.
            </p>
        </field>
    </record>

    <!-- ===== ACTION: Batch Confirm Bill ===== -->
    <record id="action_senjani_batch_confirm_bill" model="ir.actions.server">
        <field name="name">Konfirmasi Bill Terpilih</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    records.action_senjani_confirm_bill()
        </field>
        <field name="groups_id" eval="[(4, ref('senjani_accounting.group_senjani_accounting_staff'))]"/>
    </record>

    <!-- ===== ACTION: Bank Statement / Mutasi Bank ===== -->
    <record id="action_senjani_bank_statement_bri" model="ir.actions.act_window">
        <field name="name">Mutasi Bank</field>
        <field name="res_model">account.bank.statement</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('journal_id.type', '=', 'bank')]</field>
        <field name="context">{'default_journal_id': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada mutasi Bank
            </p>
            <p>
                Input mutasi Bank di sini, lalu cocokkan (reconcile) dengan
                invoice/bill yang sudah dikonfirmasi. Setelah rekonsiliasi berhasil,
                status invoice akan berubah menjadi Lunas (Paid).
            </p>
        </field>
    </record>

</odoo>
