<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         VENDOR BILL (PURCHASE) — Custom Views for the Accounting Team
         ================================================================ -->

    <!-- ===== LIST VIEW: Vendor Bill ===== -->
    <record id="view_senjani_bill_list" model="ir.ui.view">
        <field name="name">senjani.account.move.bill.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Vendor Bills"
                  create="0"
                  decoration-info="state == 'draft'"
                  decoration-success="payment_state == 'paid'"
                  decoration-warning="payment_state in ('partial','not_paid') and state == 'posted'"
                  decoration-muted="state == 'cancel'"
                  multi_edit="1">
                <field name="name" string="Bill Number" optional="show"/>
                <field name="invoice_date" string="Bill Date" optional="show"/>
                <field name="invoice_date_due" string="Due Date" optional="show"/>
                <field name="partner_id" string="Vendor" optional="show"/>
                <field name="purchase_id" string="Purchase Order" optional="show"/>
                <field name="ref" string="Vendor Reference" optional="show"/>
                <field name="amount_untaxed" string="Untaxed Amount" optional="show"/>
                <field name="amount_tax" string="Tax" optional="hide"/>
                <field name="amount_total" string="Total" optional="show"/>
                <field name="amount_residual" string="Amount Due" optional="show"/>
                <field name="currency_id" string="Currency" optional="hide"/>
                <field name="state" string="Status"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'posted'"
                       decoration-danger="state == 'cancel'"/>
                <field name="payment_state" string="Payment Status"
                       widget="badge"
                       decoration-success="payment_state == 'paid'"
                       decoration-warning="payment_state == 'partial'"
                       decoration-danger="payment_state == 'not_paid'"
                       optional="show"/>
                <field name="move_type" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ===== SEARCH VIEW: Vendor Bill ===== -->
    <record id="view_senjani_bill_search" model="ir.ui.view">
        <field name="name">senjani.account.move.bill.search</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search string="Search Vendor Bills">
                <field name="name" string="Bill Number"/>
                <field name="partner_id" string="Vendor"/>
                <field name="ref" string="Vendor Reference"/>
                <field name="invoice_date" string="Date"/>

                <!-- Filters -->
                <filter name="filter_draft"
                         string="🕐 Draft"
                         domain="[('state', '=', 'draft')]"/>
                <filter name="filter_posted"
                         string="✅ Posted (Unpaid)"
                         domain="[('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]"/>
                <filter name="filter_paid"
                         string="💰 Paid"
                         domain="[('payment_state', '=', 'paid')]"/>
                <filter name="filter_overdue"
                         string="⚠️ Overdue"
                         domain="[('invoice_date_due', '!=', False), ('payment_state', 'not in', ['paid', 'in_payment']), ('state', '=', 'posted')]"/>

                <separator/>

                <filter name="filter_this_month"
                         string="📅 This Month"
                         domain="[]"
                         context="{'group_by': 'invoice_date:month'}"/>

                <separator/>

                <!-- Group by -->
                <group string="Group By">
                    <filter name="groupby_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="groupby_payment_state" string="Payment Status"
                            context="{'group_by': 'payment_state'}"/>
                    <filter name="groupby_partner" string="Vendor"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="groupby_date" string="Date"
                            context="{'group_by': 'invoice_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===== ACTION: Vendor Bills ===== -->
    <record id="action_senjani_vendor_bills" model="ir.actions.act_window">
        <field name="name">Vendor Bills</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_senjani_bill_list')}),
        ]"/>
        <field name="domain">[('move_type', '=', 'in_invoice')]</field>
        <field name="context">{
            'default_move_type': 'in_invoice',
            'search_default_filter_draft': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Vendor Bills yet
            </p>
            <p>
                Vendor Bills are automatically created as Draft when a Purchase Order is confirmed
                and goods are received. Confirm bills here, then match them with bank statements to complete payments.
            </p>
        </field>
    </record>

    <!-- ===== ACTION: Batch Confirm Bill ===== -->
    <record id="action_senjani_batch_confirm_bill" model="ir.actions.server">
        <field name="name">Confirm Selected Bills</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    records.action_senjani_confirm_bill()
        </field>
        <field name="groups_id" eval="[(4, ref('senjani_accounting.group_senjani_accounting_staff'))]"/>
    </record>

    <!-- ===== ACTION: Vendor Refunds ===== -->
    <record id="action_senjani_vendor_refunds" model="ir.actions.act_window">
        <field name="name">Refunds</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_senjani_bill_list')}),
        ]"/>
        <field name="domain">[('move_type', '=', 'in_refund')]</field>
        <field name="context">{
            'default_move_type': 'in_refund',
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Vendor Refunds yet
            </p>
            <p>
                Vendor Refunds (Debit Notes) are used to record returns to vendors and retrieve refunds.
            </p>
        </field>
    </record>

    <!-- ===== ACTION: Bank Statements ===== -->
    <record id="action_senjani_bank_statement_bri" model="ir.actions.act_window">
        <field name="name">Bank Statements</field>
        <field name="res_model">account.bank.statement</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('journal_id.type', '=', 'bank')]</field>
        <field name="context">{'default_journal_id': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Bank Statements yet
            </p>
            <p>
                Import or create bank statements here. Then match (reconcile) each transaction line
                with outstanding invoices/bills. Once matched, the invoice/bill changes to Paid.
            </p>
        </field>
    </record>

    <!-- ===== VIEW INHERITANCE: Enable Create Bank Statement Button ===== -->
    <record id="view_bank_statement_tree_inherit_senjani" model="ir.ui.view">
        <field name="name">account.bank.statement.list.inherit.senjani</field>
        <field name="model">account.bank.statement</field>
        <field name="inherit_id" ref="account.view_bank_statement_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="create">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- ===== FORM VIEW: Custom Form for Manual Bank Statement Creation ===== -->
    <record id="view_bank_statement_form_senjani" model="ir.ui.view">
        <field name="name">account.bank.statement.form.senjani</field>
        <field name="model">account.bank.statement</field>
        <field name="arch" type="xml">
            <form string="Bank Statement">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Statement Reference"/>
                        <h1>
                            <field name="name" placeholder="e.g. Bank Statement May 2026" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="journal_id" string="Bank Journal" domain="[('type', '=', 'bank')]" required="1"/>
                            <field name="date" string="Date" required="1"/>
                        </group>
                        <group>
                            <field name="balance_start" string="Starting Balance"/>
                            <field name="balance_end_real" string="Ending Balance"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Transactions" name="lines">
                            <field name="line_ids" context="{'default_journal_id': journal_id, 'default_date': date}">
                                <list string="Transactions" editable="bottom">
                                    <field name="date" string="Date"/>
                                    <field name="payment_ref" string="Reference / Label"/>
                                    <field name="partner_id" string="Partner" optional="show"/>
                                    <field name="amount" string="Amount (IDR)"/>
                                    <field name="is_reconciled" column_invisible="1"/>
                                    <button name="action_open_reconcile_wizard" string="Reconcile" type="object" icon="fa-share-square-o" invisible="is_reconciled"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===== TRANSLATION OVERRIDE: Help Text translation ===== -->
    <record id="account.action_bank_statement_tree" model="ir.actions.act_window">
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your bank statements
            </p>
            <p>
                A bank statement is a summary of all financial transactions occurring over a given period of time on your bank account.
            </p>
            <p>
                Odoo allows you to reconcile statement lines directly with customer invoices or vendor bills.
            </p>
        </field>
    </record>

</odoo>
