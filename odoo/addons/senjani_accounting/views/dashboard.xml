<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ================================================================
        DASHBOARD — Senjani Accounting
        ================================================================
        Uses Odoo 18 native Journal Dashboard (Kanban).
        Action: account.open_account_journal_dashboard_kanban
        ================================================================
    -->

    <!-- ===== ACTION: Bank Statement / Bank Reconciliation ===== -->
    <record id="action_senjani_bank_reconciliation" model="ir.actions.act_window">
        <field name="name">Bank Reconciliation</field>
        <field name="res_model">account.bank.statement.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('journal_id.type', '=', 'bank')]</field>
        <field name="context">{'search_default_not_matched': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No bank transactions to match
            </p>
            <p>
                All bank transactions are reconciled with customer invoices or vendor bills.
            </p>
        </field>
    </record>

    <!-- ===== INHERIT KANBAN DASHBOARD: Limit Actions from Dashboard ===== -->
    <record id="view_senjani_journal_dashboard_kanban_inherit" model="ir.ui.view">
        <field name="name">account.journal.dashboard.kanban.inherit.senjani</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.account_journal_dashboard_kanban_view"/>
        <field name="arch" type="xml">
            <!-- Replace sale journal body content with a simple button 'View Invoices' -->
            <xpath expr="//t[@t-name='JournalBodySalePurchase']//t[@t-if=&quot;journal_type == 'sale'&quot;]" position="replace">
                <t t-if="journal_type == 'sale'">
                    <button type="object" name="open_action" class="btn btn-primary">
                        View Invoices
                    </button>
                </t>
            </xpath>
            <!-- Replace purchase journal body content with a simple button 'View Bills' -->
            <xpath expr="//t[@t-name='JournalBodySalePurchase']//t[@t-if=&quot;journal_type == 'purchase'&quot;]" position="replace">
                <t t-if="journal_type == 'purchase'">
                    <button type="object" name="open_action" class="btn btn-primary">
                        View Bills
                    </button>
                </t>
            </xpath>
            <!-- Hide 'New' option from dropdown menus in sale & purchase journal cards -->
            <xpath expr="//div[@name='kanban_manage_new' and @groups='account.group_account_invoice']" position="attributes">
                <attribute name="groups">base.group_no_one</attribute>
            </xpath>
            <!-- Hide 'Journal Items' option from dropdown menus in sale & purchase journal cards -->
            <xpath expr="//t[@t-name='menu']//a[@context=&quot;{'action_name': 'action_account_moves_all_a'}&quot;]" position="attributes">
                <attribute name="groups">base.group_no_one</attribute>
            </xpath>
            <!-- Adjust graph loading conditions so it is only displayed when there is data -->
            <xpath expr="//t[@t-call='JournalBodyGraph']" position="attributes">
                <attribute name="t-if">['bank', 'cash', 'credit'].includes(journal_type) and !bank_unconfigured or (['sale', 'purchase'].includes(journal_type) and !journal_is_empty)</attribute>
            </xpath>
            <!-- Replace empty helper text for sales journal -->
            <xpath expr="//t[@name='empty_journal_helper']/span[@t-if=&quot;journal_type == 'sale'&quot;]" position="replace">
                <span class="text-muted" t-if="journal_type == 'sale'">Validate draft invoices generated from e-commerce (Xendit) orders and manage customer receivables.</span>
            </xpath>
            <!-- Replace empty helper text for purchase journal -->
            <xpath expr="//t[@name='empty_journal_helper']/span[@t-if=&quot;journal_type == 'purchase'&quot;]" position="replace">
                <span class="text-muted" t-if="journal_type == 'purchase'">Verify vendor bills (3-Way Matching) based on Purchase Orders and warehouse reception data.</span>
            </xpath>
            <!-- Replace empty helper text for bank journal -->
            <xpath expr="//t[@name='empty_journal_helper']/span[@t-if=&quot;journal_type == 'bank'&quot;]" position="replace">
                <t t-if="journal_type == 'bank'">
                    <span class="text-muted" t-if="record.code.raw_value == 'XNDT'">Manage escrow funds from e-commerce (Xendit) transactions before payout to the bank.</span>
                    <span class="text-muted" t-if="record.code.raw_value != 'XNDT'">Manage Bank statements, record mutations, and reconcile them with customer invoices and vendor bills.</span>
                </t>
            </xpath>

            <!-- Add code and unpaid payment fields to access in templates -->
            <xpath expr="//kanban/field[1]" position="before">
                <field name="code"/>
                <field name="senjani_unpaid_payment_count"/>
                <field name="senjani_unpaid_payment_amount"/>
            </xpath>

            <!-- Add To Reconcile label for unpaid payments -->
            <xpath expr="//div[@id='dashboard_bank_cash_right']" position="inside">
                <div class="row" t-if="record.senjani_unpaid_payment_count.raw_value > 0">
                    <div class="col overflow-hidden text-start">
                        <button type="object" name="open_payments_action" class="btn btn-link p-0 text-decoration-none">
                            <span title="Payments to Reconcile">
                                <t t-esc="record.senjani_unpaid_payment_count.raw_value"/> To Reconcile
                            </span>
                        </button>
                    </div>
                    <div class="col-auto text-end">
                        <span dir="ltr"><field name="senjani_unpaid_payment_amount"/></span>
                    </div>
                </div>
            </xpath>

            <!-- Customize buttons for Bank/Cash cards based on journal code -->
            <xpath expr="//t[@t-name='JournalBodyBankCash']//div[@name='bank_cash_buttons']" position="replace">
                <div name="bank_cash_buttons" class="d-flex gap-1">
                    <!-- Xendit Journal (XNDT) Buttons -->
                    <t t-if="record.code.raw_value == 'XNDT'">
                        <button type="object" name="open_customer_payments_action" class="btn btn-primary">
                            Customer Payments
                        </button>
                    </t>
                    <!-- Main Bank Journal (BNK1) / Other Bank Buttons -->
                    <t t-else="">
                        <t t-set="bank_requires_setup" t-value="!record.bank_account_id.raw_value and ['undefined', 'online_sync'].includes(dashboard.bank_statements_source)"/>
                        <button t-if="journal_type == 'bank' and bank_requires_setup" name="action_configure_bank_journal" type="object" class="btn btn-primary" groups="account.group_account_basic">Bank Setup</button>
                        <button id="all_transactions_btn" type="object" name="open_action" class="btn btn-primary">Statements</button>
                        <button type="object" name="open_payments_action" class="btn btn-secondary">Payments</button>
                    </t>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
