<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ================================================================
        INITIAL CONFIGURATION DATA — Senjani Accounting
        ================================================================
        This file prepares the default configuration for:
        1. Special Xendit Journal (to keep Xendit transactions separate from other bank accounts)
        ================================================================
        NOTE: This record is only created if it doesn't exist yet (noupdate="1").
        ================================================================
    -->
    <data noupdate="1">
        <!-- Xendit Bank Journal creation moved to python (_setup_senjani_outstanding_accounts) to avoid UniqueViolation -->
    </data>

    <!-- Run function to auto-configure outstanding payment accounts on XNDT and BNK1 journals -->
    <data>
        <function model="account.journal" name="_setup_senjani_outstanding_accounts"/>
    </data>
</odoo>
