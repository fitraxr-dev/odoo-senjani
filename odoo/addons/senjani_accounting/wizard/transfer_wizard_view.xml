<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_senjani_transfer_wizard_form" model="ir.ui.view">
        <field name="name">senjani.transfer.wizard.form</field>
        <field name="model">senjani.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Transfer Funds">
                <sheet>
                    <group>
                        <group>
                            <field name="journal_id" options="{'no_open': True}"/>
                            <field name="destination_journal_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group>
                            <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="date"/>
                            <field name="memo"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm Transfer" type="object" name="action_transfer" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
