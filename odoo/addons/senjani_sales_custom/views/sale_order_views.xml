<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_direct_invoice" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.direct.invoice</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Hide standard wizard buttons -->
            <xpath expr="//button[@name='%(sale.action_view_sale_advance_payment_inv)d'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='%(sale.action_view_sale_advance_payment_inv)d'][2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Add direct draft invoice generation buttons -->
            <xpath expr="//button[@name='%(sale.action_view_sale_advance_payment_inv)d'][1]" position="after">
                <button name="action_create_invoices_directly" string="Create Invoice" type="object" class="btn-primary" invisible="invoice_status != 'to_invoice'"/>
            </xpath>
            <xpath expr="//button[@name='%(sale.action_view_sale_advance_payment_inv)d'][2]" position="after">
                <button name="action_create_invoices_directly" string="Create Invoice" type="object" invisible="invoice_status != 'no'"/>
            </xpath>
        </field>
    </record>
</odoo>
