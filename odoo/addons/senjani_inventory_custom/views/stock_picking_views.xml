<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_picking_form_inherit_no_resi" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.no.resi</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Tambahkan field No. Resi di bawah partner_id (Delivery Address) -->
            <xpath expr="//field[@name='partner_id'][@nolabel='1']" position="after">
                <field name="x_no_resi"
                       string="No. Resi"
                       placeholder="Masukkan nomor resi pengiriman..."
                       invisible="picking_type_code != 'outgoing'"/>
            </xpath>
        </field>
    </record>
</odoo>
