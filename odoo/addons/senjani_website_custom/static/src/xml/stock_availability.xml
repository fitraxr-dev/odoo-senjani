<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="senjani_website_custom.product_availability" t-inherit="website_sale_stock.product_availability" t-inherit-mode="extension">
        <xpath expr="//div[@id='product_stock_availability']" position="replace">
            <div t-if="is_storable and !prevent_zero_price_sale" id="product_stock_availability">
                
                <!-- 1. Kondisi stok habis -->
                <div t-if="free_qty lte 0 and !cart_qty" t-attf-class="availability_message_#{product_template} mb-1">
                    <div id="out_of_stock_message">
                        <t t-if='has_out_of_stock_message' t-out='out_of_stock_message'/>
                        <t t-elif="!allow_out_of_stock_order">
                            <div class="text-danger fw-bold">
                                <i class="fa fa-times me-1"/>
                                Out of Stock
                            </div>
                        </t>
                    </div>
                </div>

                <!-- 2. CUSTOM SENJANI: Selalu tayangkan pesan sisa kuantitas jika stok tersedia -->
                <div t-elif="free_qty > 0" id="senjani_stock_message" t-attf-class="availability_message_#{product_template} mt-2 fw-bold" style="color: var(--senjani-4); display: flex; align-items: center;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="me-2">
                        <path d="M19 3H5C3.89 3 3 3.9 3 5V19C3 20.1 3.89 21 5 21H19C20.11 21 21 20.1 21 19V5C21 3.9 20.11 3 19 3ZM19 19H5V5H19V19ZM17 9H7V7H17V9ZM13 13H7V11H13V13ZM13 17H7V15H13V17Z" fill="currentColor"/>
                    </svg>
                    <span>Stok tersedia: <t t-esc="formatQuantity(free_qty)"/> <t t-esc="uom_name" /></span>
                </div>

                <!-- 3. Kondisi jika semua qty sudah dimasukkan ke keranjang pelanggan tersebut -->
                <div id="already_in_cart_message" t-elif="!allow_out_of_stock_order and cart_qty and free_qty lte 0" t-attf-class="availability_message_#{product_template} text-warning mt8">
                    Seluruh stok yang tersedia sudah ada di keranjang Anda.
                </div>

            </div>
        </xpath>
    </t>
</templates>
