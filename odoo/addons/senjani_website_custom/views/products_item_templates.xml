<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="senjani_products_item" inherit_id="website_sale.products_item" name="Senjani Products Item">
        <!-- Tambahkan class 'senjani-product-card' pada form container -->
        <xpath expr="//form[hasclass('oe_product_cart')]" position="attributes">
            <attribute name="class" add="senjani-product-card" separator=" "/>
        </xpath>

        <!-- Tambahkan badge Out of Stock di dalam oe_product_image -->
        <xpath expr="//div[hasclass('oe_product_image')]" position="inside">
            <!-- Safe check availability: Gunakan properti qty_available (standar Odoo Stock) di product.template -->
            <t t-set="is_out_of_stock" t-value="product.is_storable and 'allow_out_of_stock_order' in product and not product.allow_out_of_stock_order and product.qty_available &lt;= 0"/>
            <t t-if="is_out_of_stock">
                <span class="senjani-out-of-stock-badge position-absolute top-0 start-0 m-2 badge bg-danger">
                    Out of Stock
                </span>
            </t>
        </xpath>

        <!-- Ubah title menjadi font Senjani -->
        <xpath expr="//h6[hasclass('o_wsale_products_item_title')]//a[hasclass('text-primary')]" position="attributes">
            <attribute name="class" remove="text-primary text-primary-emphasis" add="senjani-product-title" separator=" "/>
        </xpath>

        <!-- Styling discount (strike-through price) -->
        <xpath expr="//del" position="attributes">
            <attribute name="class" add="senjani-discount-price" separator=" "/>
        </xpath>
    </template>
</odoo>