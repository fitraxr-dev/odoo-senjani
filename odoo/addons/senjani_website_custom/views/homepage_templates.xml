<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template Override for Odoo Homepage -->
    <template id="senjani_homepage" inherit_id="website.homepage" name="Senjani Homepage Custom">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="senjani-homepage-container">
                
                <!-- Hero Banner Section -->
                <section class="senjani-hero-banner py-5">
                    <div class="container">
                        <div class="senjani-banner-card position-relative overflow-hidden shadow-lg">
                            <div class="senjani-banner-overlay d-flex align-items-center justify-content-center">
                                <h1 class="senjani-banner-title text-center text-uppercase">
                                    SENJANI<br/><span class="subtitle">SCARF</span>
                                </h1>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Kategori Section -->
                <section class="senjani-categories-section py-4">
                    <div class="container">
                        <div class="senjani-section-container p-4 p-md-5 rounded-5 shadow-sm">
                            <div class="senjani-container-title-wrapper">
                                <h2 class="senjani-container-title">Kategori</h2>
                            </div>
                            
                            <!-- Categories Grid -->
                            <div class="row row-cols-2 row-cols-sm-3 row-cols-md-5 g-4 justify-content-center">
                                <!-- Dynamic loop or static mockup placeholders -->
                                <t t-set="public_categories" t-value="request.env['product.public.category'].search([], limit=10)"/>
                                
                                <t t-if="public_categories">
                                    <t t-foreach="public_categories" t-as="cat">
                                        <t t-set="int_cat" t-value="request.env['product.category'].sudo().search([('name', '=ilike', cat.name)], limit=1)"/>
                                        <div class="col text-center">
                                            <a t-att-href="'/shop?category_id=' + str(int_cat.id) if int_cat else '/shop'" class="senjani-category-link text-decoration-none">
                                                <div class="senjani-category-img-wrapper mb-3 mx-auto shadow-sm">
                                                    <img t-if="cat.image_1920" t-attf-src="/web/image/product.public.category/#{cat.id}/image_1920" class="img-fluid senjani-category-img" t-att-alt="cat.name"/>
                                                    <img t-else="" src="/senjani_website_custom/static/src/img/Category_Section_placeholder.png" class="img-fluid senjani-category-img" t-att-alt="cat.name"/>
                                                </div>
                                                <span class="senjani-category-name" t-esc="cat.name"/>
                                            </a>
                                        </div>
                                    </t>
                                </t>
                                <t t-else="">
                                    <!-- Fallback Mockup Categories -->
                                    <t t-set="mockup_cats" t-value="[
                                        {'name': 'Hijab'},
                                        {'name': 'Hijab'},
                                        {'name': 'Kaligrafi'},
                                        {'name': 'Kopiah'},
                                        {'name': 'Mukena'},
                                        {'name': 'Parfum'},
                                        {'name': 'Sajadah'},
                                        {'name': 'Sarung'},
                                        {'name': 'Tasbih'},
                                        {'name': 'Baju Koko'}
                                    ]"/>
                                    <t t-foreach="mockup_cats" t-as="cat">
                                        <t t-set="real_cat" t-value="request.env['product.category'].sudo().search([('name', '=ilike', cat['name'])], limit=1)"/>
                                        <div class="col text-center">
                                            <a t-att-href="'/shop?category_id=' + str(real_cat.id) if real_cat else '/shop'" class="senjani-category-link text-decoration-none">
                                                <div class="senjani-category-img-wrapper mb-3 mx-auto shadow-sm">
                                                    <img src="/senjani_website_custom/static/src/img/Category_Section_placeholder.png" class="img-fluid senjani-category-img" t-att-alt="cat['name']"/>
                                                </div>
                                                <span class="senjani-category-name" t-esc="cat['name']"/>
                                            </a>
                                        </div>
                                    </t>
                                </t>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Produk Terpopuler Section -->
                <section class="senjani-products-section py-4">
                    <div class="container">
                        <div class="senjani-section-container p-4 p-md-5 rounded-5 shadow-sm">
                            <div class="senjani-container-title-wrapper">
                                <h2 class="senjani-container-title">Produk Terpopuler</h2>
                            </div>
                            
                            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-4 justify-content-center">
                                <t t-set="popular_products" t-value="list({p.name.strip(): p for p in request.env['product.template'].sudo().search([('website_published', '=', True)]).sorted(key='sales_count', reverse=True)}.values())[:5]"/>
                                
                                <t t-if="popular_products">
                                    <t t-foreach="popular_products" t-as="product">
                                        <div class="col">
                                            <t t-call="senjani_website_custom.senjani_custom_product_card"/>
                                        </div>
                                    </t>
                                </t>
                                <t t-else="">
                                    <!-- Mockup fallback cards -->
                                    <t t-foreach="[1,2,3,4,5]" t-as="item">
                                        <div class="col">
                                            <t t-call="senjani_website_custom.senjani_mockup_product_card"/>
                                        </div>
                                    </t>
                                </t>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Produk Rekomendasi Section -->
                <section class="senjani-products-section py-4">
                    <div class="container">
                        <div class="senjani-section-container p-4 p-md-5 rounded-5 shadow-sm">
                            <div class="senjani-container-title-wrapper">
                                <h2 class="senjani-container-title">Produk Rekomendasi</h2>
                            </div>
                            
                            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-4 justify-content-center">
                                <t t-set="rec_products" t-value="list({p.name.strip(): p for p in request.env['product.template'].sudo().search([('website_published', '=', True)]).sorted(key='qty_available', reverse=True)}.values())[:5]"/>
                                
                                <t t-if="rec_products">
                                    <t t-foreach="rec_products" t-as="product">
                                        <div class="col">
                                            <t t-call="senjani_website_custom.senjani_custom_product_card"/>
                                        </div>
                                    </t>
                                </t>
                                <t t-else="">
                                    <!-- Mockup fallback cards -->
                                    <t t-foreach="[1,2,3,4,5]" t-as="item">
                                        <div class="col">
                                            <t t-call="senjani_website_custom.senjani_mockup_product_card"/>
                                        </div>
                                    </t>
                                </t>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Aesthetic Section -->
                <section class="senjani-aesthetic-section py-5">
                    <div class="container">
                        <div class="senjani-aesthetic-card p-4 p-md-5 rounded-4 shadow-sm">
                            <div class="row align-items-center g-5">
                                <div class="col-md-5">
                                    <div class="senjani-aesthetic-img-container overflow-hidden rounded-3 shadow-md">
                                        <img src="/senjani_website_custom/static/src/img/Aesthetic_Section.png" class="img-fluid w-100 h-100 object-fit-cover" alt="The Aesthetic of Senjani"/>
                                    </div>
                                </div>
                                <div class="col-md-7">
                                    <div class="senjani-aesthetic-content px-md-3">
                                        <h3 class="senjani-aesthetic-subtitle text-uppercase mb-3">Estetika Senjani</h3>
                                        <p class="senjani-aesthetic-text mb-4">
                                            Senjani Scarf lahir dari apresiasi terhadap keanggunan abadi dan kenyamanan sehari-hari. Terinspirasi oleh warna senja yang hangat dan menenangkan, kami menghadirkan selendang premium yang dirancang untuk melengkapi gaya hidup modern Anda. Setiap helai dibuat dengan cermat menggunakan kain berkualitas tinggi yang jatuh dengan indah, memastikan Anda tampil anggun dan merasa percaya diri sepanjang hari.
                                        </p>
                                        <a href="/shop" class="btn btn-lg senjani-btn-aesthetic px-5 py-3 text-uppercase shadow-sm">Telusuri Lebih Lanjut</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

            </div>
        </xpath>
    </template>

    <!-- Custom Reusable Product Card (Dynamic Odoo Data) -->
    <template id="senjani_custom_product_card" name="Senjani Custom Product Card">
        <div class="card h-100 senjani-landing-product-card border-0 shadow-sm overflow-hidden">
            <div class="position-relative senjani-card-img-container">
                <a t-attf-href="/shop/product/#{product.id}">
                    <img t-if="product.image_512" t-attf-src="/web/image/product.template/#{product.id}/image_512" class="card-img-top senjani-product-img" t-att-alt="product.name"/>
                    <img t-else="" src="/senjani_website_custom/static/src/img/senjani_placeholder.png" class="card-img-top senjani-product-img" t-att-alt="product.name"/>
                </a>
                <!-- Wishlist Heart Icon overlay -->
                <button class="btn btn-light rounded-circle position-absolute top-0 end-0 m-3 shadow-sm senjani-wishlist-btn o_add_to_wishlist" t-att-data-product-template-id="product.id" t-att-data-product-product-id="product.product_variant_id.id">
                    <i class="fa fa-heart"/>
                </button>
            </div>
            <div class="card-body p-3 d-flex flex-column justify-content-between">
                <div>
                    <h5 class="card-title mb-1">
                        <a t-attf-href="/shop/product/#{product.id}" t-esc="product.name" class="text-decoration-none text-dark fw-bold senjani-card-title-link"/>
                    </h5>
                    <!-- Star Ratings -->
                    <div class="senjani-rating-stars mb-2 small">
                        <i class="fa fa-star text-warning"/>
                        <i class="fa fa-star text-warning"/>
                        <i class="fa fa-star text-warning"/>
                        <i class="fa fa-star text-warning"/>
                        <i class="fa fa-star-o text-secondary"/>
                        <span class="text-muted small ms-1">(92)</span>
                    </div>
                </div>
                <div class="d-flex align-items-center justify-content-between mt-2">
                    <span class="senjani-product-price fw-bold" t-field="product.list_price" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                </div>
            </div>
        </div>
    </template>

    <!-- Custom Reusable Product Card (Mockup Fallback Data) -->
    <template id="senjani_mockup_product_card" name="Senjani Mockup Product Card">
        <div class="card h-100 senjani-landing-product-card border-0 shadow-sm overflow-hidden">
            <div class="position-relative senjani-card-img-container">
                <a href="/shop">
                    <img src="/senjani_website_custom/static/src/img/senjani_placeholder.png" class="card-img-top senjani-product-img" alt="Muslimah Fashion 1"/>
                </a>
                <!-- Wishlist Heart Icon overlay -->
                <button class="btn btn-light rounded-circle position-absolute top-0 end-0 m-3 shadow-sm senjani-wishlist-btn o_add_to_wishlist">
                    <i class="fa fa-heart"/>
                </button>
            </div>
            <div class="card-body p-3 d-flex flex-column justify-content-between">
                <div>
                    <h5 class="card-title mb-1">
                        <a href="/shop" class="text-decoration-none text-dark fw-bold senjani-card-title-link">Muslimah Fashion 1</a>
                    </h5>
                    <!-- Star Ratings -->
                    <div class="senjani-rating-stars mb-2 small">
                        <i class="fa fa-star text-warning"/>
                        <i class="fa fa-star text-warning"/>
                        <i class="fa fa-star text-warning"/>
                        <i class="fa fa-star text-warning"/>
                        <i class="fa fa-star-o text-secondary"/>
                        <span class="text-muted small ms-1">(92)</span>
                    </div>
                </div>
                <div class="d-flex align-items-center justify-content-between mt-2">
                    <span class="senjani-product-price fw-bold">Rp 131.000,00</span>
                </div>
            </div>
        </div>
    </template>

    <!-- Load Google Fonts in the website layout head -->
    <template id="senjani_fonts" inherit_id="website.layout" name="Senjani Fonts">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
            <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&amp;family=Playfair+Display:ital,wght@0,400;0,700;1,400&amp;display=swap" rel="stylesheet"/>
        </xpath>
    </template>
</odoo>