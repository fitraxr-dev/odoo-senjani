<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_jne" model="ir.ui.view">
        <field name="name">stock.picking.form.jne</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <!-- ============================================================
                 1. HEADER — Tombol "Cek Resi JNE"
                    Hanya tampil jika nomor resi sudah diisi.
            ============================================================ -->
            <xpath expr="//header" position="inside">
                <button name="action_check_resi_jne"
                        string="Cek Resi JNE"
                        type="object"
                        class="btn-primary"
                        invisible="not x_no_resi"/>
            </xpath>

            <!-- ============================================================
                 2. FORM BODY — Field "No. Resi JNE"
                    Ditampilkan tepat di bawah field carrier_id agar mudah
                    ditemukan oleh tim gudang saat proses packing selesai.

                    Aturan:
                    - Hanya tampil untuk Delivery Order (outgoing)
                    - Wajib diisi selama status belum done/cancel
            ============================================================ -->
            <xpath expr="//field[@name='origin']" position="after">
                <field name="x_no_resi"
                       string="No. Resi JNE"
                       placeholder="Masukkan nomor resi dari kurir JNE sebelum klik Validate..."
                       invisible="picking_type_code != 'outgoing'"
                       required="picking_type_code == 'outgoing' and state not in ['done', 'cancel']"/>
            </xpath>

            <!-- ============================================================
                 3. NOTEBOOK — Tab "Tracking JNE"
                    Menampilkan riwayat perjalanan paket hasil cek resi.
                    Field readonly karena diisi otomatis oleh sistem.
            ============================================================ -->
            <xpath expr="//notebook" position="inside">
                <page string="Tracking JNE" name="tracking_jne"
                      invisible="picking_type_code != 'outgoing'">
                    <field name="x_tracking_status"
                           widget="text"
                           nolabel="1"
                           placeholder="Status tracking akan muncul di sini setelah Anda mengklik 'Cek Resi JNE'..."
                           readonly="1"/>
                </page>
            </xpath>

            <!-- ============================================================
                 4. SEMBUNYIKAN — Tab "Additional Info"
                    Disembunyikan agar tampilan lebih bersih dan fokus.
            ============================================================ -->
            <xpath expr="//page[@name='extra']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- ============================================================
                 5. SEMBUNYIKAN — Field "Move Type"
                    Field teknis, tidak dibutuhkan oleh tim operasional.
            ============================================================ -->
            <xpath expr="//field[@name='move_type']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>
</odoo>