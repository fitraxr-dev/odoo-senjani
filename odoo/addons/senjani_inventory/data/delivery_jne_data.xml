<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Product Service untuk JNE -->
        <record id="product_product_delivery_jne" model="product.product">
            <field name="name">Ongkos Kirim JNE</field>
            <field name="default_code">JNE_ONGKIR</field>
            <field name="type">service</field>
            <field name="categ_id" ref="product.product_category_all"/>
            <field name="sale_ok" eval="False"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price">0.0</field>
        </record>

        <!-- Delivery Carrier: JNE Express -->
        <record id="delivery_carrier_jne" model="delivery.carrier">
            <field name="name">JNE Express</field>
            <field name="fixed_price">0.0</field>
            <field name="free_over" eval="False"/>
            <field name="amount" eval="0.0"/>
            <field name="return_label_on_delivery" eval="False"/>
            <field name="get_return_label_from_portal" eval="False"/>
            <field name="delivery_type">jne</field>
            <field name="product_id" ref="product_product_delivery_jne"/>
        </record>
        
    </data>
</odoo>
